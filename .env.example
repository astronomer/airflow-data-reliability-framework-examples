# Airflow connection used by the demo DAGs.
RELIABILITY_DEMO_CONN_ID=warehouse

# Optional table namespace and prefix. Examples:
# Snowflake: MY_DATABASE.MY_SCHEMA
# Postgres:  my_schema
# Leave the namespace blank to use the connection's default database/schema.
RELIABILITY_DEMO_TABLE_NAMESPACE=
RELIABILITY_DEMO_TABLE_PREFIX=demo_

# PydanticAI connection and optional model override used by the AI DAGs.
# Leave the model blank to use the model configured on the connection.
RELIABILITY_DEMO_LLM_CONN_ID=llm
RELIABILITY_DEMO_MODEL=
RELIABILITY_DEMO_REQUIRE_APPROVAL=0

# How long the layer 3 sensor waits for today's vendor file, in minutes.
# Kept short so you can watch it expire in a demo.
RELIABILITY_DEMO_ARRIVAL_WINDOW_MINUTES=10

# Example connection definitions. Use one, or create the connection in the Astro UI instead.
# AIRFLOW_CONN_WAREHOUSE='postgres://user:password@host:5432/dbname'
# AIRFLOW_CONN_WAREHOUSE='{"conn_type": "snowflake", "login": "...", "password": "...", "schema": "DEMO", "extra": {"account": "...", "database": "...", "warehouse": "...", "role": "..."}}'